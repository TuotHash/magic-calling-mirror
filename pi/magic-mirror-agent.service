[Unit]
Description=Magic Mirror Pi agent (display control, CEC, optional PIR)
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/magic-mirror/config
ExecStart=/usr/local/bin/magic_mirror_agent.py
# xset talks to the kiosk's X server; start-mirror.sh grants us access.
Environment=DISPLAY=:0
Restart=on-failure
RestartSec=3

User=magic-mirror-agent
Group=magic-mirror-agent
SupplementaryGroups=gpio video

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# ...but keep the X socket directory visible for xset.
BindPaths=-/tmp/.X11-unix
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
